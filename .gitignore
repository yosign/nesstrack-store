# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# track-design offline pipeline artifacts (regenerated by tools/trace_thumbnails.py)
/tools/trace_output/cache/
/tools/trace_output/*.png
/tools/trace_output/templates.json
/tools/.venv/
# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
